{
  "name": {
    "en": "Indoor unit",
    "nl": "Binnenunit",
    "fr": "Unité intérieure"
  },
  "class": "airconditioning",
  "capabilities": [
    "onoff",
    "target_temperature",
    "measure_temperature",
    "measure_humidity",
    "measure_temperature.outdoor",
    "measure_power",
    "meter_power",
    "samsung_hvac_mode",
    "samsung_fan_speed",
    "samsung_swing",
    "samsung_preset",
    "onoff.auto_clean",
    "samsung_filter_usage",
    "alarm_generic.filter",
    "button.filter_reset",
    "alarm_generic",
    "samsung_error_code",
    "measure_temperature.eva_in",
    "measure_temperature.eva_out",
    "button.restart"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 16,
      "max": 30,
      "step": 1,
      "decimals": 0
    },
    "measure_temperature": {
      "title": {
        "en": "Room temperature",
        "nl": "Kamertemperatuur",
        "fr": "Température ambiante"
      }
    },
    "measure_temperature.outdoor": {
      "title": {
        "en": "Outdoor temperature",
        "nl": "Buitentemperatuur",
        "fr": "Température extérieure"
      }
    },
    "measure_power": {
      "title": {
        "en": "Power (outdoor unit)",
        "nl": "Vermogen (buitenunit)",
        "fr": "Puissance (unité extérieure)"
      }
    },
    "meter_power": {
      "title": {
        "en": "Energy (outdoor unit)",
        "nl": "Energie (buitenunit)",
        "fr": "Énergie (unité extérieure)"
      }
    },
    "onoff.auto_clean": {
      "title": {
        "en": "Auto clean",
        "nl": "Automatische reiniging",
        "fr": "Nettoyage automatique"
      },
      "uiQuickAction": false
    },
    "alarm_generic.filter": {
      "title": {
        "en": "Clean the filter",
        "nl": "Filter reinigen",
        "fr": "Nettoyer le filtre"
      }
    },
    "button.filter_reset": {
      "title": {
        "en": "Reset filter counter",
        "nl": "Filterteller resetten",
        "fr": "Réinitialiser le compteur du filtre"
      },
      "maintenanceAction": true
    },
    "alarm_generic": {
      "title": {
        "en": "Fault",
        "nl": "Storing",
        "fr": "Panne"
      }
    },
    "measure_temperature.eva_in": {
      "title": {
        "en": "Evaporator in",
        "nl": "Verdamper in",
        "fr": "Évaporateur entrée"
      },
      "insights": false
    },
    "measure_temperature.eva_out": {
      "title": {
        "en": "Evaporator out",
        "nl": "Verdamper uit",
        "fr": "Évaporateur sortie"
      },
      "insights": false
    },
    "button.restart": {
      "title": {
        "en": "Restart bridge",
        "nl": "Bridge herstarten",
        "fr": "Redémarrer le pont"
      },
      "maintenanceAction": true
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "select"
    },
    {
      "id": "manual",
      "navigation": {
        "prev": "select"
      }
    },
    {
      "id": "api_key",
      "navigation": {
        "prev": "select"
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "prev": "api_key",
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}